NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Neon direct connection for Prisma migrations and data import. Runtime can
# use the pooled DATABASE_URL above.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

JWT_SECRET="your-long-random-secret"

FRONTEND_URL="http://localhost:5173,http://localhost:5174,https://www.lynmarieboutique.com,https://lynmarieboutique.com"

# Password reset email (backend only). The sender domain must be verified in Resend.
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Lyn Marie Boutique <info@lynmarieboutique.com>"
PASSWORD_RESET_URL="https://lynmarieboutique.com/auth/forgot-password"
